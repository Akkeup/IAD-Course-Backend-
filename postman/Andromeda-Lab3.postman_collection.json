{
  "info": {
    "_postman_id": "f37392d7-8698-45e5-91bf-a33094e22ac6",
    "name": "Andromeda Stars - Лабораторная 3",
    "description": "10 REST-методов лабораторной 3. GET ленты выполняется дважды: сначала без query-параметров, затем с id={{feed_id}} и next=true. Изменяющие методы возвращают только HTTP-статус с пустым телом.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 GET список услуг с фильтром",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars?distance_kpc=20&page=1",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars"],
          "query": [
            { "key": "distance_kpc", "value": "20", "description": "Максимальное расстояние в килопарсеках" },
            { "key": "page", "value": "1" }
          ]
        },
        "description": "Возвращает только опубликованные услуги. В каждой записи должен присутствовать признак is_owner: 0 или 1."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "pm.test('Список содержит is_owner', () => {",
              "  const body = pm.response.json();",
              "  pm.expect(body.items).to.be.an('array');",
              "  body.items.forEach(item => pm.expect(item.is_owner).to.be.oneOf([0, 1]));",
              "});"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "02 POST добавить услугу с файлами",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            { "key": "name", "value": "Отчётная звезда", "type": "text" },
            { "key": "image", "type": "file", "src": "" },
            { "key": "video", "type": "file", "src": "" }
          ]
        },
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars"]
        },
        "description": "Перед отправкой выберите локальные image и video. Content-Type вручную не задавайте: Postman сформирует multipart boundary. У текущего пользователя не должно быть другого черновика."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 201', () => pm.response.to.have.status(201));",
              "pm.test('Тело ответа пустое', () => pm.expect(pm.response.text()).to.equal(''));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "03 GET черновик текущего пользователя",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars/draft",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars", "draft"]
        },
        "description": "ID в URL не передаётся. После успешного ответа ID черновика автоматически записывается в переменную star_id."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('star_id', body.id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "04 PUT опубликовать услугу",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Отчётная звезда\",\n  \"catalog_id\": \"M31-REPORT-2026\",\n  \"distance_kpc\": 19.4,\n  \"velocity_kms\": 220,\n  \"description\": \"Карточка для демонстрации публикации в лабораторной работе.\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars/{{star_id}}/publish",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars", "{{star_id}}", "publish"]
        },
        "description": "Публикует только черновик текущего пользователя. star_id устанавливается запросом 03."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 204', () => pm.response.to.have.status(204));",
              "pm.test('Тело ответа пустое', () => pm.expect(pm.response.text()).to.equal(''));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "05 GET лента услуг",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars/feed",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars", "feed"],
          "query": [
            { "key": "id", "value": "{{feed_id}}", "description": "Включить для второго запуска", "disabled": true },
            { "key": "next", "value": "true", "description": "Включить вместе с id для второго запуска", "disabled": true }
          ]
        },
        "description": "Первый запуск: оба параметра выключены. Запрос сохранит ID полученной записи в feed_id. Второй запуск: включите id и next=true. По требованию ответ должен содержать is_liked: 0 или 1."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 200', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.collectionVariables.set('feed_id', body.id);"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "06 POST поставить или отменить лайк",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"value\": 1\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars/{{feed_id}}/like",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars", "{{feed_id}}", "like"]
        },
        "description": "value=1 ставит лайк, value=0 отменяет. feed_id устанавливается запросом ленты."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 204', () => pm.response.to.have.status(204));",
              "pm.test('Тело ответа пустое', () => pm.expect(pm.response.text()).to.equal(''));"
            ]
          }
        }
      ],
      "response": []
    },
    {
      "name": "07 DELETE удалить свою услугу",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/andromeda-stars/{{star_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "andromeda-stars", "{{star_id}}"]
        },
        "description": "Выполняет soft delete только собственной активной услуги. star_id устанавливается запросом черновика."
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Статус 204', () => pm.response.to.have.status(204));",
              "pm.test('Тело ответа пустое', () => pm.expect(pm.response.text()).to.equal(''));"
            ]
          }
        }
      ],
      "response": []
    },
    {
