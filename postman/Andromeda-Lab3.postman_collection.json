        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"report_user_{{$timestamp}}\",\n  \"password\": \"Lab3_secure_password_2026\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": {
          "raw": "{{base_url}}/api/users/register",
          "host": ["{{base_url}}"],
          "path": ["api", "users", "register"]
        },
        "description": "Динамический timestamp делает username уникальным при повторных запусках. Пароль сохраняется на сервере как Argon2id-хеш."
      },
      "event": [
